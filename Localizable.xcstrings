    "gpu_memory_help" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Speicher für Grafikdaten. Auf Macs mit Apple silicon zeigt „Gesamt“ den RAM des Computers, den CPU und GPU gemeinsam nutzen." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Memory for graphics data. On Macs with Apple silicon, Total shows the computer's RAM shared by the CPU and GPU." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Память для графических данных. На Mac с Apple silicon «Всего» показывает общую RAM компьютера, которой пользуются CPU и GPU." } }
      }
    },
