      }
    },
    "gpu_tiler_help" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Auslastung des GPU-Bereichs, der die Geometrie einer Szene zum Zeichnen vorbereitet." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Activity of the part of the GPU that prepares scene geometry for drawing." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Занятость части GPU, которая подготавливает объекты сцены к отрисовке." } }
      }
    },
    "gpu_neural_engine_help" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Auslastung der Apple Neural Engine, eines Beschleunigers für maschinelles Lernen." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Activity of the Apple Neural Engine, an accelerator for machine-learning tasks." } },
