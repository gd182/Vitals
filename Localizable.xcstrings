    "gpu_utilization_help" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Auslastung des Grafikprozessors bei Grafikaufgaben und Berechnungen." } },
