    "memory_pressure_help" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt, ob dem System genügend RAM zur Verfügung steht. Normal: Der Bedarf wird gedeckt. Erhöht: Die Speicherressourcen werden knapp. Kritisch: Speichermangel kann das System verlangsamen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indicates whether the system has enough RAM. Normal: memory demands are being met. Elevated: memory resources are getting tight. Critical: memory shortages may slow the system down."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывает, хватает ли системе RAM. Нормальная: потребности в памяти обеспечены. Повышенная: ресурсов памяти становится мало. Критическая: нехватка памяти может замедлять систему."
          }
        }
      }
    },
    "memory_pressure_normal" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
